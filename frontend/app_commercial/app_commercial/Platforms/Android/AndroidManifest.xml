<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:versionCode="1" android:versionName="1.0" package="com.companyname.app_commercial">
	<!--
	  ⚠️ VÉRIFIE CETTE LIGNE : "package" doit correspondre exactement à la
	  valeur <ApplicationId> de ton fichier app_commercial.csproj.
	  Ouvre le .csproj, cherche <ApplicationId>...</ApplicationId>, et si la
	  valeur est différente de "com.companyname.app_commercial", remplace-la
	  ci-dessus par la valeur exacte du .csproj.
	-->

	<uses-sdk />

	<!-- Permissions -->
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<!-- Nécessaire pour que le suivi continue quand l'app n'est pas ouverte.
	     Android affichera obligatoirement une demande séparée "Toujours autoriser"
	     à l'utilisateur (pas possible de l'obtenir silencieusement). -->
	<uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<!-- Android 13+ exige la permission explicite pour afficher la notification
	     obligatoire du foreground service. -->
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

	<application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true">
		<!--
		  ⚠️ VÉRIFIE CES ATTRIBUTS : android:icon / android:roundIcon doivent
		  correspondre aux noms de ressources réellement présents dans ton
		  dossier Platforms/Android/Resources/mipmap-*/. Le template MAUI par
		  défaut utilise "appicon" et "appicon_round" — si ton projet avait un
		  nom différent avant l'écrasement, ajuste ici.
		-->

		<!-- Déclaration manuelle du service (voir commentaire dans
		     BackgroundLocationService.cs pour la raison de ce choix) -->
		<service
			android:name="app_commercial.Platforms.Android.BackgroundLocationService"
			android:exported="false"
			android:foregroundServiceType="location" />

		<!-- Le BroadcastReceiver (BootReceiver.cs) est déclaré automatiquement
		     via l'attribut [BroadcastReceiver] du code C# — rien à ajouter ici
		     pour lui, MAUI génère l'entrée <receiver> au build. -->
	</application>

    
</manifest>