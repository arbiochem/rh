<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="app_commercial.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Image
                Source="logo.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="Logo" />
            
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a hovercraft number nine" />

            <Label
                Text="Pointage"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Entry
                x:Name="PhoneEntry"
                Placeholder="Numéro de téléphone"
                Text="0320374985"
                Keyboard="Telephone" 
                IsEnabled="False"/>

            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                <Button
                    x:Name="EntreeBtn"
                    Text="Entrée"
                    BackgroundColor="Green"
                    TextColor="White"
                    Clicked="OnEntreeClicked" />

                <Button
                    x:Name="SortieBtn"
                    Text="Sortie"
                    BackgroundColor="Red"
                    TextColor="White"
                    Clicked="OnSortieClicked" />
            </HorizontalStackLayout>

            <Label x:Name="StatusLabel" Text="" HorizontalOptions="Center" />

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>